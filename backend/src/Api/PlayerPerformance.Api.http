@PlayerPerformance_Api_HostAddress = http://localhost:5051

### List matches
GET {{PlayerPerformance_Api_HostAddress}}/api/matches

### Get a match
GET {{PlayerPerformance_Api_HostAddress}}/api/matches/00000000-0000-0000-0000-000000000000

GET {{PlayerPerformance_Api_HostAddress}}/health
Accept: application/json

### Get a CSRF token before an unsafe auth request
GET {{PlayerPerformance_Api_HostAddress}}/api/auth/csrf
Accept: application/json

### Sign in (send the requestToken returned above in X-CSRF-TOKEN)
POST {{PlayerPerformance_Api_HostAddress}}/api/auth/login
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": "staff@example.com",
  "password": "temporary-password"
}

### Read the current safe session
GET {{PlayerPerformance_Api_HostAddress}}/api/auth/session
Accept: application/json

### Change the currently authenticated user's password
POST {{PlayerPerformance_Api_HostAddress}}/api/auth/change-password
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "currentPassword": "temporary-password",
  "newPassword": "Replacement!Pass123",
  "confirmPassword": "Replacement!Pass123"
}

### Sign out
POST {{PlayerPerformance_Api_HostAddress}}/api/auth/logout
X-CSRF-TOKEN: {{csrfToken}}

### List team selections (admin)
GET {{PlayerPerformance_Api_HostAddress}}/api/settings/teams

### Create a team selection (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/settings/teams
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{ "name": "U16", "trackingLevel": "STANDARD" }

### Replace the complete non-archived team order (admin)
PUT {{PlayerPerformance_Api_HostAddress}}/api/settings/teams/order
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{ "orderedTeamIds": ["00000000-0000-0000-0000-000000000001"] }

### List players (admin)
GET {{PlayerPerformance_Api_HostAddress}}/api/players?page=1&pageSize=25

### Create player (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/players
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{ "firstName": "Amar", "lastName": "Kovač", "preferredName": "Aki", "dateOfBirth": "2005-02-03" }

### Archive player (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/players/00000000-0000-0000-0000-000000000001/archive
X-CSRF-TOKEN: {{csrfToken}}

### List a player's assignment history (authenticated staff with access)
GET {{PlayerPerformance_Api_HostAddress}}/api/players/00000000-0000-0000-0000-000000000001/assignments

### Create a player assignment (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/players/00000000-0000-0000-0000-000000000001/assignments
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{ "teamId": "00000000-0000-0000-0000-000000000002", "startDate": "2026-07-01" }

### End a player assignment (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/players/00000000-0000-0000-0000-000000000001/assignments/00000000-0000-0000-0000-000000000003/end
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{ "endDate": "2026-12-31" }

### Create a venue (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/settings/venues
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{ "name": "Stadion" }

### Create an opponent (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/settings/opponents
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{ "name": "FK Example" }

### List venues, including archived records (admin)
GET {{PlayerPerformance_Api_HostAddress}}/api/settings/venues?includeArchived=true

### Get a venue (admin)
GET {{PlayerPerformance_Api_HostAddress}}/api/settings/venues/00000000-0000-0000-0000-000000000001

### Update a venue (admin)
PATCH {{PlayerPerformance_Api_HostAddress}}/api/settings/venues/00000000-0000-0000-0000-000000000001
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{ "name": "Stadion Mostar" }

### Archive a venue (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/settings/venues/00000000-0000-0000-0000-000000000001/archive
X-CSRF-TOKEN: {{csrfToken}}

### Restore a venue (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/settings/venues/00000000-0000-0000-0000-000000000001/restore
X-CSRF-TOKEN: {{csrfToken}}

### List opponents, including archived records (admin)
GET {{PlayerPerformance_Api_HostAddress}}/api/settings/opponents?includeArchived=true

### Get an opponent (admin)
GET {{PlayerPerformance_Api_HostAddress}}/api/settings/opponents/00000000-0000-0000-0000-000000000001

### Update an opponent (admin)
PATCH {{PlayerPerformance_Api_HostAddress}}/api/settings/opponents/00000000-0000-0000-0000-000000000001
Content-Type: application/json
X-CSRF-TOKEN: {{csrfToken}}

{ "name": "FK Example Updated" }

### Archive an opponent (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/settings/opponents/00000000-0000-0000-0000-000000000001/archive
X-CSRF-TOKEN: {{csrfToken}}

### Restore an opponent (admin)
POST {{PlayerPerformance_Api_HostAddress}}/api/settings/opponents/00000000-0000-0000-0000-000000000001/restore
X-CSRF-TOKEN: {{csrfToken}}
