# Copy this file to backend/.env for local development.
# Never commit real backend/.env files.
# Production should use real environment variables or a managed secret store.

ASPNETCORE_ENVIRONMENT=Development
PlayerPerformance__ServiceName=Player Performance API
PlayerPerformance__FrontendOrigin=http://localhost:5173
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=player_performance;Username=app_user;Password=change_me

Bootstrap__FirstAdmin__Enabled=false
Bootstrap__FirstAdmin__Name=Administrator
Bootstrap__FirstAdmin__Email=admin@example.com
Bootstrap__FirstAdmin__TemporaryPassword=change-this-temporary-password

# Local file storage is development-only. Real .env files remain uncommitted.
# Production must use an approved non-local provider; future features may set lower limits.
FileStorage__Provider=Local
FileStorage__LocalRootPath=./.local-storage
FileStorage__MaxObjectSizeBytes=1073741824
# Per-media endpoint ceiling. It must not exceed FileStorage__MaxObjectSizeBytes.
Media__MaxUploadSizeBytes=536870912
# Import workflow limits. Must not exceed FileStorage__MaxObjectSizeBytes.
Imports__MaxUploadSizeBytes=536870912
Imports__PreviewRowLimit=100
Imports__ProcessingLeaseTimeoutMinutes=30
# Configurable parser safety ceilings; they are not vendor export requirements.
Imports__HeaderScanRowLimit=25
Imports__CsvDetectionRowLimit=25
Imports__MaxRowsPerFile=100000
Imports__MaxColumnsPerFile=500
Imports__MaxCellLengthCharacters=10000
Imports__MaxXlsxEntryCount=5000
Imports__MaxXlsxUncompressedSizeBytes=536870912
Imports__MaxXlsxCompressionRatio=100
Imports__TemporaryWorkingDirectory=./.import-working
